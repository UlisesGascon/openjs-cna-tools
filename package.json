{
  "name": "@ulisesgascon/openjs-cna-tools",
  "version": "1.0.0-alpha.3",
  "description": "EXPERIMENTAL fork of the OpenJS Foundation CNA tools: CLI and library for the OpenJS CNA API",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "openjs-cna-experimental": "bin/openjs-cna.js"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./review": "./lib/review/index.js",
    "./convert": "./lib/convert/ghsa.js",
    "./cvss": "./lib/cvss.js",
    "./record": "./lib/record.js",
    "./batch": "./lib/batch.js"
  },
  "files": [
    "bin/",
    "components/",
    "lib/",
    "lib/review/schemas/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'test/**/*.test.js'",
    "lint": "standard",
    "lint:fix": "standard --fix"
  },
  "devDependencies": {
    "standard": "^17.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UlisesGascon/openjs-cna-tools.git"
  },
  "keywords": [
    "cna",
    "cve",
    "openjs",
    "security"
  ]
}
